# Copy to config.env and fill in. config.env is gitignored.
#
# Base URL of your Uptime Kuma push endpoint, WITHOUT the token:
KUMA_BASE=http://127.0.0.1:3001/api/push

# One push token per check. Create a Push monitor in Kuma, copy the token
# from its Push URL.
CC_TOKEN_BACKUP=changeme
CC_TOKEN_SMART=changeme
CC_TOKEN_DNSSEC=changeme
CC_TOKEN_BLOCKING=changeme
CC_TOKEN_HTTP=changeme

# --- Per-check settings ------------------------------------------------------
# backup-archive.sh
BACKUP_DIR=/path/to/backups
BACKUP_MARKER=data/db.sqlite3      # file that MUST be inside the archive
BACKUP_MAX_AGE_H=26

# disk-smart.sh
SMART_DEVICE=/dev/nvme0n1
SMART_WEAR_LIMIT=80

# dns-dnssec.sh / dns-blocking.sh
RESOLVER_CMD=drill                 # or: docker exec unbound drill
RESOLVER_HOST=127.0.0.1
RESOLVER_PORT=53
BLOCK_DOMAINS=doubleclick.net,googleadservices.com
CONTROL_DOMAIN=example.com

# http-json.sh
HTTP_URL=http://127.0.0.1:8080/api/stats
HTTP_FIELD=data.count
HTTP_MIN=1
